{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "newradhaswami",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-10",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
